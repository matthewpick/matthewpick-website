---
/**
 * Contact form backed by FormSnare.
 *
 * Submits with fetch() so the visitor stays on this site and sees our own
 * confirmation instead of FormSnare's generic page. The `action` / `method`
 * attributes are kept as a no-JS fallback: without JavaScript the browser
 * posts natively and FormSnare renders its own confirmation page.
 */
const endpoint =
  import.meta.env.PUBLIC_FORMSNARE_ENDPOINT ?? 'https://formsnare.com/submit/matthewpick-com';
---

<div class="contact-form" data-endpoint={endpoint}>
  <form
    action={endpoint}
    method="POST"
    novalidate
    class="space-y-6 bg-card p-6 md:p-8 rounded-xl border border-border"
  >
    <div>
      <label for="name" class="block text-sm font-medium text-primary mb-2">
        Name
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full px-4 py-3 rounded-lg border border-border bg-input text-primary placeholder-placeholder focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all"
        placeholder="Your name"
      />
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-primary mb-2">
        Email
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full px-4 py-3 rounded-lg border border-border bg-input text-primary placeholder-placeholder focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all"
        placeholder="you@example.com"
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium text-primary mb-2">
        Message
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="w-full px-4 py-3 rounded-lg border border-border bg-input text-primary placeholder-placeholder focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all resize-none"
        placeholder="Your message..."
      ></textarea>
    </div>

    <p
      data-form-error
      role="alert"
      hidden
      class="text-sm rounded-lg px-4 py-3 border border-red-300 bg-red-50 text-red-800 dark:border-red-900 dark:bg-red-950/50 dark:text-red-200"
    >
    </p>

    <button
      type="submit"
      class="w-full px-6 py-3 bg-accent hover:bg-accent-hover text-white font-medium rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface disabled:opacity-60 disabled:cursor-not-allowed"
    >
      Send Message
    </button>
  </form>

  <div
    data-form-success
    role="status"
    hidden
    class="bg-card p-6 md:p-8 rounded-xl border border-border text-center"
  >
    <div
      class="w-12 h-12 mx-auto mb-4 rounded-full bg-accent-subtle flex items-center justify-center"
      aria-hidden="true"
    >
      <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h2 class="text-xl font-semibold text-primary mb-2">Thanks for reaching out!</h2>
    <p class="text-secondary">
      Your message came through. I'll get back to you at the email address you provided.
    </p>
    <p data-submission-id class="text-xs text-muted mt-4 font-mono"></p>
  </div>
</div>

<script>
  const ERROR_MESSAGES: Record<string, string> = {
    submission_limit_reached:
      "This form is temporarily not accepting messages. Please email me directly instead.",
    form_not_found: "This form is misconfigured. Please email me directly instead.",
  };
  const FALLBACK_ERROR =
    "Something went wrong sending your message. Please try again, or email me directly.";
  const NETWORK_ERROR =
    "Could not reach the server. Check your connection and try again.";

  document.querySelectorAll<HTMLElement>('.contact-form').forEach((root) => {
    const form = root.querySelector('form');
    const endpoint = root.dataset.endpoint;
    if (!form || !endpoint) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const errorBox = root.querySelector<HTMLElement>('[data-form-error]');
    const successBox = root.querySelector<HTMLElement>('[data-form-success]');
    const submissionIdBox = root.querySelector<HTMLElement>('[data-submission-id]');
    const buttonLabel = button?.textContent ?? 'Send Message';

    const showError = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.hidden = false;
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    form.addEventListener('submit', async (event) => {
      // Let the browser handle its own validation UI first.
      if (!form.reportValidity()) {
        event.preventDefault();
        return;
      }
      event.preventDefault();

      if (errorBox) errorBox.hidden = true;
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }

      // Form-encoded body keeps this a CORS-simple request, so no preflight is needed.
      const body = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (typeof value === 'string') body.append(key, value);
      });

      try {
        // `format=json` asks FormSnare for a JSON body instead of its HTML page.
        const response = await fetch(`${endpoint}?format=json`, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body,
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          const code = typeof result?.error?.code === 'string' ? result.error.code : '';
          showError(ERROR_MESSAGES[code] ?? FALLBACK_ERROR);
          return;
        }

        form.hidden = true;
        if (successBox) {
          successBox.hidden = false;
          successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        if (submissionIdBox && result.submission_id) {
          submissionIdBox.textContent = `Reference: ${result.submission_id}`;
        }
      } catch {
        showError(NETWORK_ERROR);
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = buttonLabel;
        }
      }
    });
  });
</script>
